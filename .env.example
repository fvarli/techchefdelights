# Postgres (local PostgreSQL 16)
# Format: postgresql://USER:PASS@HOST:PORT/DB
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/techchefdelights"

# Redis (rate limiting)
# Self-hosted: standard Redis
REDIS_URL="redis://127.0.0.1:6379"
# Serverless alternative (only used when REDIS_URL is unset):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cloudinary (placeholder for v1; bulk asset upload later)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Google Analytics 4 (loads only when set + NODE_ENV=production + user accepts consent)
# NEXT_PUBLIC_GA_ID=

# Sentry (env-gated; app is a no-op when DSN missing)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENV=development
# NEXT_PUBLIC_SENTRY_ENV=development
# Source-map upload requires the trio below at build time:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# App metadata
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_VERSION=local
